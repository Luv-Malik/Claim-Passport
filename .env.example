# Copy these into your environment (or docker-compose env_file). All are optional.
CP_SECRET_KEY=change-me-to-a-long-random-string
CP_DB_PATH=data/claimpassport.db
CP_UPLOAD_DIR=data/uploads
CP_TOKEN_HOURS=12
CP_EXPIRY_WARN_DAYS=14
CP_MAX_UPLOAD_MB=10
# 1 = load the demo brand, demo users and sample content on first start. Use 0 for a real install.
CP_SEED_DEMO=1
# Used only when CP_SEED_DEMO=0 (first admin account)
CP_ADMIN_EMAIL=admin@example.com
CP_ADMIN_PASSWORD=change-me-now
# Optional AI helper for extra rewrite ideas (suggestions only). Leave empty to keep everything local.
ANTHROPIC_API_KEY=
CP_USE_LLM=1
CP_LLM_MODEL=claude-sonnet-5-5
# For demos and tests only: freeze "today" (YYYY-MM-DD)
# CP_TODAY=2026-11-02

# ---- Round 3 ----
# PostgreSQL instead of the SQLite file:  CP_DATABASE_URL=postgresql://user:pass@host:5432/claimpassport
CP_DATABASE_URL=
# Key for encrypting uploads and stored secrets (long random string). Keep it safe: lost key = unreadable uploads.
CP_ENCRYPTION_KEY=
# Meaning-aware claim checking: 1 = on by default. Managers can switch it in Settings either way
CP_HYBRID=0
# Email alerts and weekly digest
CP_SMTP_HOST=
CP_SMTP_PORT=587
CP_SMTP_USER=
CP_SMTP_PASSWORD=
CP_SMTP_FROM=
CP_SMTP_TLS=starttls
CP_PUBLIC_URL=http://127.0.0.1:5000
# Slack / webhook can also be set by an admin in Settings (stored encrypted)
CP_SLACK_WEBHOOK_URL=
CP_WEBHOOK_URL=
CP_WEBHOOK_SECRET=
# Background scan (hours) and weekly digest day (0 = Monday)
CP_SCHEDULER=1
CP_SCAN_INTERVAL_HOURS=24
CP_DIGEST_WEEKDAY=0
