# Copy these into your environment (or docker-compose env_file). All are optional.
CP_SECRET_KEY=change-me-to-a-long-random-string
CP_DB_PATH=data/claimpassport.db
CP_UPLOAD_DIR=data/uploads
CP_TOKEN_HOURS=12
CP_EXPIRY_WARN_DAYS=14
CP_MAX_UPLOAD_MB=10
# 1 = load the demo brand, demo users and sample content on first start. Use 0 for a real install.
CP_SEED_DEMO=1
# Used only when CP_SEED_DEMO=0 (first admin account)
CP_ADMIN_EMAIL=admin@example.com
CP_ADMIN_PASSWORD=change-me-now
# Optional AI helper for extra rewrite ideas (suggestions only). Leave empty to keep everything local.
ANTHROPIC_API_KEY=
CP_USE_LLM=1
CP_LLM_MODEL=claude-sonnet-5-5
# For demos and tests only: freeze "today" (YYYY-MM-DD)
# CP_TODAY=2026-11-02
